DB_URL=jdbc:mysql://localhost:3306/blindbox?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_POOL_SIZE=16
DB_USER=blindbox
DB_PASSWORD=replace-with-your-local-password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Enable only after local RabbitMQ is ready. Use a dedicated user for deployment.
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
DEMO_RECHARGE_ENABLED=false
RATE_LIMIT_ENABLED=true
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173

# Concurrency limits per application instance; draw budget is capped at half DB_POOL_SIZE.
HTTP_MAX_INFLIGHT=64
DRAW_MAX_INFLIGHT=8
DRAW_MAX_PER_POOL=1
ENTRY_READ_PER_MINUTE=6000
ENTRY_WRITE_PER_MINUTE=120
ENTRY_AUTH_PER_MINUTE=20

# Per-instance Redis circuit breaker
REDIS_CIRCUIT_FAILURE_THRESHOLD=1
REDIS_CIRCUIT_OPEN_MS=1000
